{
  "name": "children-doctor",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "h5:build": "pnpm --dir h5-oral-checkup build",
    "h5:sync": "pnpm h5:build && rm -rf public/h5-oral-checkup && mkdir -p public/h5-oral-checkup && cp -r h5-oral-checkup/dist/. public/h5-oral-checkup/",
    "h5:zip": "pnpm h5:sync && node h5-oral-checkup/scripts/zip-dist.mjs",
    "cap:sync": "pnpm build && npx cap sync",
    "cap:full": "pnpm h5:sync && pnpm cap:sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/toast": "^8.0.1",
    "@capgo/capacitor-printer": "^8.0.14",
    "@children-doctor/dual-camera": "file:./src/plugins/dual-camera",
    "echarts": "^6.0.0",
    "install": "^0.13.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "swiper": "^12.0.0",
    "vconsole": "^3.15.1",
    "vue": "^3.5.31",
    "vue-echarts": "^8.0.1",
    "vue-qr": "^4.0.9",
    "vue-qrcode": "^2.2.2",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.42.0",
    "oxlint": "~1.57.0",
    "postcss": "^8.5.9",
    "postcss-px-to-viewport": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "sass-embedded": "^1.99.0",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
