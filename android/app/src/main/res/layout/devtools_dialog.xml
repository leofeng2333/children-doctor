<?xml version="1.0" encoding="utf-8"?>
<!--
  开发者工具弹窗主体。

  为什么放原生 Dialog 里：
  Capacitor WebView 不透明，整个 WebView 在 rootView contentView 中覆盖在
  preview surface 之上；反过来把 preview 推到 WebView 下面则 WebView 整张背景
  会挡住 preview（即便弹窗没打开）。所以弹窗必须用 native Dialog（WindowManager
  TYPE_APPLICATION_PANEL），原生窗口层永远高于任何 WebView / TextureView。

  控件命名按 slot 索引 + 字段后缀，便于 plugin 端按命名约定读取。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dev_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/dev_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/bg_dev_card">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/devtools_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/dev_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/devtools_close_x"
                android:textColor="#999999"
                android:textSize="22sp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- 状态行 -->
        <TextView
            android:id="@+id/dev_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:textSize="14sp"
            android:textColor="#999999"
            android:text=""/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_hint"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="20dp"/>

        <!-- 左预览 slot 0 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dev_fieldset">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devtools_slot0_preview"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/devtools_rotation"
                    android:textSize="16sp"
                    android:textColor="#000000"/>
                <Spinner
                    android:id="@+id/spinner_s0_preview_rot"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="120dp"/>
            </LinearLayout>
            <CheckBox
                android:id="@+id/check_s0_preview_mirror"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/devtools_mirror"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/devtools_zoom"
                    android:textSize="16sp"
                    android:textColor="#000000"/>
                <EditText
                    android:id="@+id/edit_s0_preview_zoom"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:maxLength="5"
                    android:hint="1.0"
                    android:textColor="#000000"
                    android:background="@drawable/bg_dev_input"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="×"
                    android:textSize="16sp"
                    android:textColor="#666666"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 右预览 slot 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dev_fieldset">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devtools_slot1_preview"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/devtools_rotation"
                    android:textSize="16sp"
                    android:textColor="#000000"/>
                <Spinner
                    android:id="@+id/spinner_s1_preview_rot"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="120dp"/>
            </LinearLayout>
            <CheckBox
                android:id="@+id/check_s1_preview_mirror"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/devtools_mirror"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/devtools_zoom"
                    android:textSize="16sp"
                    android:textColor="#000000"/>
                <EditText
                    android:id="@+id/edit_s1_preview_zoom"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:maxLength="5"
                    android:hint="1.0"
                    android:textColor="#000000"
                    android:background="@drawable/bg_dev_input"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="×"
                    android:textSize="16sp"
                    android:textColor="#666666"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 左拍照 slot 0 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dev_fieldset">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devtools_slot0_capture"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/devtools_rotation"
                    android:textSize="16sp"
                    android:textColor="#000000"/>
                <Spinner
                    android:id="@+id/spinner_s0_capture_rot"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="120dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 右拍照 slot 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_dev_fieldset">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devtools_slot1_capture"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/devtools_rotation"
                    android:textSize="16sp"
                    android:textColor="#000000"/>
                <Spinner
                    android:id="@+id/spinner_s1_capture_rot"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="120dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 错误 / 成功信息 -->
        <TextView
            android:id="@+id/dev_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/devtools_btn_cancel"
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="@drawable/bg_dev_btn_secondary"/>
            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/devtools_btn_save"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_dev_btn_primary"/>
            <Button
                android:id="@+id/btn_exit"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/devtools_btn_exit"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_dev_btn_danger"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
